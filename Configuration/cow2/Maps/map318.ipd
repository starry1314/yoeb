// 0 Basic Settings

// Upgrading Quality
[Quality] <= "1" && [Rarity] == "Normal" # [UpgradeQuality] == "true"


// Upgrade to RARE higher priority than Upgrade to Magic
[Rarity] == "Normal" 	# [UpgradeToRare] == "true"

// Upgrade to MAGIC
//[Rarity] == "Normal" 	# [UpgradeToMagic] == "true"
//[Rarity] == "Magic" 	# [AugmentIfPossible] == "true"


// Tiers to run (difficult to use since a Map can have multiple tiers)
[MapTier] >= "16" && [Rarity] == "Rare" # [RunMap] == "true"
[MapTier] >= "16" && [Rarity] == "Normal" # [RunMap] == "true"
[MapTier] >= "16" && [Rarity] == "Magic" # [RunMap] == "true"
